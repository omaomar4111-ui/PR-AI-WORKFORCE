# ─────────────────────────────────────────────────────────────────────────────
# PR AI WORKFORCE — ENVIRONMENT CONFIGURATION (EXAMPLE)
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_ENV=development
APP_SECRET=change-this-to-a-secure-random-secret-key-32-chars-min
DEBUG=true

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + pgvector / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pr_ai_workforce
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Queue & Cache (Redis)
REDIS_URL=redis://localhost:6379/0

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_NAME="PR AI WORKFORCE"
