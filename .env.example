# ─────────────────────────────────────────────────────────────────────────────
# PR AI WORKFORCE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: Copy this file to .env.production on your deployment runner.
# NEVER commit .env.production to version control.
# ─────────────────────────────────────────────────────────────────────────────

# --- Application Security Keys ---
# Generate via: python scripts/generate_secrets.py
APP_ENV=production
APP_SECRET=your_generated_64_hex_app_secret_here            # 64-char hex string for cryptographic signing
JWT_SECRET=your_generated_64_hex_jwt_secret_here            # 64-char hex string for auth token signature verification
DEBUG=false

# --- API Host & Ingress Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["https://app.yourdomain.com"]             # Production web app origin (no trailing slash)
ALLOWED_ORIGINS=https://app.yourdomain.com                  # Origin permitted for telemetry ingestion
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# --- Supabase PostgreSQL 17 + pgvector ---
# Obtain from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI / Pooler)
# Use PgBouncer port 6543 (Transaction Mode) for high-concurrency pooling
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_POOLER_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- Upstash Redis 7 (TLS Enabled) ---
# Obtain from: Upstash Console -> Database -> Connect (ioredis / redis-cli TLS URL)
REDIS_URL=rediss://default:<upstash_token>@<upstash_host>.upstash.io:6379

# --- OpenTelemetry & Observability ---
# Options: console (dev only) | otlp (production) | none
OTEL_EXPORTER=none                                          # Set to 'otlp' when Grafana Tempo / Jaeger endpoint is linked
OTEL_SAMPLING_RATE=0.1                                      # 10% adaptive sampling rate in production
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo.yourdomain.com:4317

# --- Next.js Frontend Environment ---
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
NEXT_PUBLIC_APP_NAME="PR AI WORKFORCE"
